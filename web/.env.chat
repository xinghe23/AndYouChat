# 部署到 Nginx 站点子目录 /chat/ 时使用：npm run build:chat
# 产物直接输出到项目根下的 chat/，Nginx 里 root 指向项目根即可，无需再拷贝
VITE_BASE=/chat/
VITE_OUT_DIR=../chat

# 接口前缀（站点根下的子路径）。注意只到 /chat，不要再带 /api ——
# 请求路径本身已经是 /api/v1/xxx，前缀只负责把请求从站点根挪到子目录。
# 拼出来是 /chat/api/v1/...，Nginx 侧对应：
#   location ^~ /chat/api/ { proxy_pass http://127.0.0.1:8200/api/; }
VITE_API_BASE=/chat
