# 复制为 .env 后按需修改
APP_NAME=AndYouChat
ENV=dev

# --- 数据库 ---
# 本地零依赖模式（默认，直接能跑）：
DATABASE_URL=sqlite+aiosqlite:///./andyou.db
# 切换到 Docker 里的 MySQL 8（先 docker compose up -d）：
# DATABASE_URL=mysql+aiomysql://andyou:andyou123@127.0.0.1:3306/andyouchat?charset=utf8mb4

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
# 本地没起 Redis 时置 true，用 fakeredis 进程内替代（仅单进程调试可用）
USE_FAKEREDIS=true

# --- 安全 ---
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=604800
REFRESH_TOKEN_TTL=2592000

# --- 其它 ---
CORS_ORIGINS=*
SNOWFLAKE_NODE_ID=1
MESSAGE_RECALL_SECONDS=120
