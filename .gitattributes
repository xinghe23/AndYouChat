# 统一换行符：Windows 上编辑、Linux 上运行的关键
* text=auto eol=lf

# 部署脚本/配置必须是 LF，CRLF 会导致 bad interpreter 或 nginx 解析异常
*.sh        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
Dockerfile  text eol=lf

# 二进制文件不做换行转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.gz        binary
*.zip       binary
