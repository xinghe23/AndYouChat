# 复制为 .env 后填入强密码：cp .env.db.example .env && chmod 600 .env
# 生成密码：python3 -c "import secrets;print(secrets.token_urlsafe(24))"

MYSQL_ROOT_PASSWORD=change-me-root-strong-password
MYSQL_DATABASE=andyouchat
MYSQL_USER=andyou
MYSQL_PASSWORD=change-me-app-strong-password
REDIS_PASSWORD=change-me-redis-strong-password

# 可选：宿主机端口映射。宿主 3306 已被其他 MySQL 占用时设为 3307
# MYSQL_HOST_PORT=3307
# REDIS_HOST_PORT=6379
